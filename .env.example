# Environment Variables (No secrets)

# Supabase PostgreSQL Configuration for Shared Multi-Device Storage (Server-Side Only - Never prefix with VITE_):
# Set these in your Vercel Project Settings > Environment Variables:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Direct PostgreSQL Connection URI (Optional - for running psql migrations / pooler):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Meteorological Workstation Authentication Configuration for Vercel / Production Deployment:
WXOPS_AMSS_PASSWORD=imd123
WXOPS_RWFC_PASSWORD=imd123
SESSION_SECRET=change-this-to-a-cryptographically-secure-random-string-in-production
